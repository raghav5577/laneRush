# ==============================================================================
# LaneRush .gitignore
# Rules strictly adhering to AGENTS.md §2 (Hard Rules) & Project Architecture
# ==============================================================================

# 1. Environment & Secrets (AGENTS.md §2 rule 9)
.env
.env.*
!.env.example

# 2. Virtual Environments & Packages
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/
*.egg

# 3. Python Bytecode & Runtime Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# 4. SUMO Generated Network & Route Files (AGENTS.md §2 rule 9)
# Regenerated deterministically via scenarios/grid3x3/build_net.sh & make_routes.py
*.net.xml
*.rou.xml
*.rou.alt.xml
tripinfo.xml
*.tripinfo.xml

# 5. Machine Learning Models & Weights (AGENTS.md §2 rule 9)
# Never commit model weights (*.pt); commit only metrics.json
*.pt
*.pth
*.onnx
*.engine
*.tflite

# 6. Datasets & Raw Media
data/
dataset/
datasets/
Emergency vehicle*/
*.zip
*.tar
*.tar.gz
*.csv.zip

# 7. Experiment Runs, Analysis Outputs & Scratch Scripts (AGENTS.md §2 rule 9 & §11)
# Regenerated by `lanerush sweep` and `lanerush analyze`
runs/
results/
scratch/
starter.py
*.log
ml/runs/
ml/results/*
!ml/results/metrics.json

# 8. Local Database & Container Volumes
pgdata/
dump.rdb

# 9. IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
*Colab.pdf

# 10. Dashboard & Web UI Runtime
.streamlit/
node_modules/
frontend/node_modules/
frontend/dist/

# 11. Helper & Explanation Markdown Documents (Keep local, exclude from GitHub)
docs/*.md
!docs/log.md


agents.md
